OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Required: Claude writes the reports (chat text is sent to Anthropic). BRANDON_PROVIDER=local switches to Ollama.
ANTHROPIC_API_KEY=
# Or use your Claude subscription instead: install Claude Code on this server and
# paste the token from `claude setup-token` here. It takes priority over the API key.
CLAUDE_CODE_OAUTH_TOKEN=
# After creating your accounts, set this to closed so nobody else can sign up.
BRANDON_SIGNUPS=open
ALLOWED_ORIGINS=https://gilsamedia.github.io
